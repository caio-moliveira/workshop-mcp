# Copie para backend/.env e troque a senha. O .env não é versionado.

# Papel dono: usado pela carga para recriar o banco.
POSTGRES_USER=dono
POSTGRES_PASSWORD=troque-esta-senha

# Banco criado pela carga.
BANCO=marketplace

# Papel de Vendas: só lê a camada de leitura de Vendas.
SENHA_DO_PAPEL_VENDAS=troque-esta-senha-de-vendas

# Papel de Produtos: só lê a camada de leitura de Produtos. Quem já tem o ambiente no ar acrescenta
# esta linha ao .env e refaz a carga.
SENHA_DO_PAPEL_PRODUTOS=troque-esta-senha-de-produtos

# Papel do Comercial: só lê a camada de leitura do Comercial. Quem já tem o ambiente no ar
# acrescenta esta linha ao .env e refaz a carga.
SENHA_DO_PAPEL_COMERCIAL=troque-esta-senha-do-comercial

# Papel da Diretoria: só lê a camada de leitura da Diretoria, já agregada (ADR 0011). Quem já tem
# o ambiente no ar acrescenta esta linha ao .env e refaz a carga.
SENHA_DO_PAPEL_DIRETORIA=troque-esta-senha-da-diretoria

# Papel da auditoria: o servidor MCP grava com ele cada chamada no banco `auditoria`, e ele só
# pode inserir. A carga reaplica esta senha a cada execução, sem apagar a auditoria (ADR 0008).
SENHA_DO_PAPEL_AUDITORIA=troque-esta-senha-da-auditoria

# Papel do histórico: a API lê e grava com ele as conversas no banco `historico`, e ele só alcança
# esse banco. A carga reaplica esta senha a cada execução, sem apagar o histórico (ADR 0009).
SENHA_DO_PAPEL_HISTORICO=troque-esta-senha-do-historico

# Limite de frequência do servidor MCP (RS-11): LIMITE_DE_CHAMADAS_POR_USUARIO (padrão 30) e
# JANELA_DO_LIMITE_EM_SEGUNDOS (padrão 60), definidas no shell que roda o docker compose, como
# as portas, e não neste arquivo: o compose as passa ao serviço mcp. A suíte de testes precisa do
# servidor com um limite alto (veja a seção Testes do README).

# Assistente da aplicação (entrega 5a).
# Modelo de linguagem, no formato provedor:modelo do PydanticAI. Trocar de modelo é só mudar esta
# linha e recriar a API (docker compose up -d --wait api). Vazia ou ausente: o padrão abaixo.
MODELO_DO_ASSISTENTE=anthropic:claude-haiku-5-5
# Chave do provedor do modelo, na variável que o próprio provedor lê. Vazia, o ambiente sobe
# normalmente e o painel avisa que o assistente está indisponível.
ANTHROPIC_API_KEY=
# Endereço interno do servidor MCP, pela rede do compose, que a API chama com o token de quem
# pergunta. O compose já o define para o serviço api (ENDERECO_INTERNO_DO_MCP); só muda se o
# servidor MCP mudar de nome, porta ou caminho.
# ENDERECO_INTERNO_DO_MCP=http://mcp:8001/mcp
# Tetos de cada pergunta ao assistente. Vazios ou ausentes: os padrões abaixo.
# Chamadas de ferramenta por pergunta: ao atingir, a resposta para com um aviso.
LIMITE_DE_CHAMADAS_POR_PERGUNTA=8
# Caracteres da pergunta: acima, 400.
LIMITE_DE_CARACTERES_DA_PERGUNTA=2000
# Tempo máximo de uma pergunta, em segundos: ao passar, a resposta termina com erro.
TEMPO_MAXIMO_DA_PERGUNTA_EM_SEGUNDOS=60

# Endereços públicos: dois modos, um emissor só por vez.
# - Modo local (padrão): os valores abaixo.
# - Modo túnel (V1): as duas variáveis valem o endereço base do túnel, sem barra no fim e sem
#   /mcp, por exemplo https://exemplo-de-tunel.trycloudflare.com. Para ligar:
#   1. docker compose --profile tunel up -d --wait
#   2. Leia o endereço do túnel no log: docker compose logs tunel (a linha com trycloudflare.com).
#   3. Ponha esse endereço em ENDERECO_PUBLICO_DO_PROVEDOR e ENDERECO_PUBLICO_DO_MCP.
#   4. docker compose up -d --wait, SEM o perfil: recria quem depende dos endereços e deixa o
#      túnel no ar com o mesmo endereço. Com --profile tunel, o compose recriaria também o túnel,
#      que ganharia um endereço novo.
#   Para voltar ao modo local, ponha os valores abaixo de volta, desligue o túnel
#   (docker compose stop tunel) e suba o compose de novo. Não deixe o túnel ligado: nesse modo o
#   registro de clientes e o servidor MCP ficam expostos na internet. Trocar o endereço do túnel
#   ou reiniciar o provedor apaga os clientes registrados pelos assistentes: remova e adicione o
#   conector de novo.

# Provedor de identidade (Keycloak).
# Endereço público: o emissor dos tokens. Muda na verificação com túnel e no ambiente público.
ENDERECO_PUBLICO_DO_PROVEDOR=http://localhost:8080
# Endereço do frontend: para onde o provedor devolve o usuário depois do login e a única
# origem que a API aceita do navegador (CORS).
ENDERECO_DO_FRONTEND=http://localhost:5173
# Endereço público do servidor MCP, sem o /mcp: o recurso que ele anuncia nos metadados de
# recurso protegido (RFC 9728) e que o MCP Inspector e os assistentes externos usam para
# descobrir onde fazer login. Precisa ser o endereço que o cliente digita.
# A porta publicada do servidor MCP é opcional: MCP_PORT (padrão 8001), definida no shell que roda
# o docker compose e os testes, como API_PORT, POSTGRES_PORT e PROXY_PORT (a do proxy reverso,
# padrão 8088), e não neste arquivo, que o compose não lê para as portas. Se MCP_PORT mudar, a
# porta deste endereço muda junto.
ENDERECO_PUBLICO_DO_MCP=http://localhost:8001
# Administrador do console do Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-de-admin
# Senhas dos usuários de demonstração (ana.vendas, vitor.vendas, bruno.produtos, carla.comercial,
# diego.diretoria). Vendas tem dois, para mostrar que um não vê o histórico do outro (RF-18).
SENHA_DO_USUARIO_VENDAS=troque-esta-senha-da-ana
SENHA_DO_USUARIO_VENDAS_VITOR=troque-esta-senha-do-vitor
SENHA_DO_USUARIO_PRODUTOS=troque-esta-senha-do-bruno
SENHA_DO_USUARIO_COMERCIAL=troque-esta-senha-da-carla
SENHA_DO_USUARIO_DIRETORIA=troque-esta-senha-do-diego
