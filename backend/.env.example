# Copie para backend/.env e troque a senha. O .env não é versionado.

# Papel dono: usado pela carga para recriar o banco.
POSTGRES_USER=dono
POSTGRES_PASSWORD=troque-esta-senha

# Banco criado pela carga.
BANCO=marketplace

# Papel de Vendas: só lê a camada de leitura de Vendas.
SENHA_DO_PAPEL_VENDAS=troque-esta-senha-de-vendas

# Provedor de identidade (Keycloak).
# Endereço público: o emissor dos tokens. Muda na verificação com túnel e no ambiente público.
ENDERECO_PUBLICO_DO_PROVEDOR=http://localhost:8080
# Endereço do frontend: para onde o provedor devolve o usuário depois do login e a única
# origem que a API aceita do navegador (CORS).
ENDERECO_DO_FRONTEND=http://localhost:5173
# Administrador do console do Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-de-admin
# Senhas dos usuários de demonstração (ana.vendas, bruno.produtos, carla.comercial, diego.diretoria).
SENHA_DO_USUARIO_VENDAS=troque-esta-senha-da-ana
SENHA_DO_USUARIO_PRODUTOS=troque-esta-senha-do-bruno
SENHA_DO_USUARIO_COMERCIAL=troque-esta-senha-da-carla
SENHA_DO_USUARIO_DIRETORIA=troque-esta-senha-do-diego
