# Copie para backend/.env e troque a senha. O .env não é versionado.

# Papel dono: usado pela carga para recriar o banco.
POSTGRES_USER=dono
POSTGRES_PASSWORD=troque-esta-senha

# Banco criado pela carga.
BANCO=marketplace

# Papel de Vendas: só lê a camada de leitura de Vendas.
SENHA_DO_PAPEL_VENDAS=troque-esta-senha-de-vendas

# Endereços públicos: dois modos, um emissor só por vez.
# - Modo local (padrão): os valores abaixo.
# - Modo túnel (V1): as duas variáveis valem o endereço base do túnel, sem barra no fim e sem
#   /mcp, por exemplo https://exemplo-de-tunel.trycloudflare.com. Para ligar:
#   1. docker compose --profile tunel up -d --wait
#   2. Leia o endereço do túnel no log: docker compose logs tunel (a linha com trycloudflare.com).
#   3. Ponha esse endereço em ENDERECO_PUBLICO_DO_PROVEDOR e ENDERECO_PUBLICO_DO_MCP.
#   4. docker compose up -d --wait, SEM o perfil: recria quem depende dos endereços e deixa o
#      túnel no ar com o mesmo endereço. Com --profile tunel, o compose recriaria também o túnel,
#      que ganharia um endereço novo.
#   Para voltar ao modo local, ponha os valores abaixo de volta, desligue o túnel
#   (docker compose stop tunel) e suba o compose de novo. Não deixe o túnel ligado: nesse modo o
#   registro de clientes e o servidor MCP ficam expostos na internet. Trocar o endereço do túnel
#   ou reiniciar o provedor apaga os clientes registrados pelos assistentes: remova e adicione o
#   conector de novo.

# Provedor de identidade (Keycloak).
# Endereço público: o emissor dos tokens. Muda na verificação com túnel e no ambiente público.
ENDERECO_PUBLICO_DO_PROVEDOR=http://localhost:8080
# Endereço do frontend: para onde o provedor devolve o usuário depois do login e a única
# origem que a API aceita do navegador (CORS).
ENDERECO_DO_FRONTEND=http://localhost:5173
# Endereço público do servidor MCP, sem o /mcp: o recurso que ele anuncia nos metadados de
# recurso protegido (RFC 9728) e que o MCP Inspector e os assistentes externos usam para
# descobrir onde fazer login. Precisa ser o endereço que o cliente digita.
# A porta publicada do servidor MCP é opcional: MCP_PORT (padrão 8001), definida no shell que roda
# o docker compose e os testes, como API_PORT, POSTGRES_PORT e PROXY_PORT (a do proxy reverso,
# padrão 8088), e não neste arquivo, que o compose não lê para as portas. Se MCP_PORT mudar, a
# porta deste endereço muda junto.
ENDERECO_PUBLICO_DO_MCP=http://localhost:8001
# Administrador do console do Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-de-admin
# Senhas dos usuários de demonstração (ana.vendas, bruno.produtos, carla.comercial, diego.diretoria).
SENHA_DO_USUARIO_VENDAS=troque-esta-senha-da-ana
SENHA_DO_USUARIO_PRODUTOS=troque-esta-senha-do-bruno
SENHA_DO_USUARIO_COMERCIAL=troque-esta-senha-da-carla
SENHA_DO_USUARIO_DIRETORIA=troque-esta-senha-do-diego
