{
  "realm": "pulso",
  "displayName": "pulso.",
  "enabled": true,
  "loginTheme": "pulso",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": "${INATIVIDADE_DA_SESSAO_EM_SEGUNDOS}",
  "ssoSessionMaxLifespan": 36000,
  "defaultSignatureAlgorithm": "RS256",
  "groups": [
    { "name": "Vendas", "path": "/Vendas", "attributes": { "perfil": ["vendas"] } },
    { "name": "Produtos", "path": "/Produtos", "attributes": { "perfil": ["produtos"] } },
    { "name": "Comercial", "path": "/Comercial", "attributes": { "perfil": ["comercial"] } },
    { "name": "Diretoria", "path": "/Diretoria", "attributes": { "perfil": ["diretoria"] } }
  ],
  "users": [
    {
      "username": "ana.vendas",
      "firstName": "Ana",
      "lastName": "Ribeiro",
      "email": "ana.ribeiro@pulso.example",
      "emailVerified": true,
      "enabled": true,
      "groups": ["/Vendas"],
      "credentials": [{ "type": "password", "value": "${SENHA_DO_USUARIO_VENDAS}", "temporary": false }]
